# AWS Configuration
AWS_REGION=eu-north-1
# RENT_NIVAS_AWS_REGION=eu-north-1  # fallback alias

# Cognito
COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=your-cognito-domain.auth.eu-north-1.amazoncognito.com
COGNITO_REDIRECT_URI=https://your-domain.com/auth/callback

# Google OAuth (configured in Cognito as Identity Provider)
GOOGLE_AUTH_URI=https://your-cognito-domain.auth.eu-north-1.amazoncognito.com/oauth2/authorize
GOOGLE_TOKEN_URI=https://your-cognito-domain.auth.eu-north-1.amazoncognito.com/oauth2/token
GOOGLE_USERINFO_URI=
GOOGLE_SCOPES=openid email profile
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are configured in the AWS Console, not here

# S3 Storage
S3_BUCKET=your-bucket-name
S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.eu-north-1.amazonaws.com
S3_UPLOAD_ACL=

# Brevo SMTP (for email verification and password reset)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-key

# Email sender identity
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Rent Nivas

# SES (alternative email provider)
SES_REGION=eu-north-1
SES_FROM_EMAIL=noreply@yourdomain.com

# DynamoDB Tables (optional - defaults shown)
TABLE_USERS=Users
TABLE_VERIFICATION_CODES=VerificationCodes
TABLE_PARTNER_APPLICATIONS=PartnerApplications
TABLE_PARTNER_TASKS=PartnerTasks
TABLE_PARTNER_TASK_PROGRESS=PartnerTaskProgress
TABLE_PURCHASES=Purchases
TABLE_HOUSES=Properties
TABLE_LISTING_QUESTIONS=PropertyQuestions
TABLE_ANSWERS=PropertyAnswers
TABLE_ADMIN_ANNOUNCEMENTS=AdminAnnouncements
TABLE_ADMIN_WARNINGS=Warnings
TABLE_WARNING_VIEWS=WarningViews
TABLE_ANNOUNCEMENT_VIEWS=AnnouncementViews
TABLE_ADMIN_BANS=Bans
TABLE_ADMIN_APPEALS=Appeals
TABLE_USER_HOUSE_UNLOCKS=UserHouseUnlocks
TABLE_FAVORITES=Favorites
TABLE_NOTIFICATIONS=Notifications
TABLE_CONTACTS=Contacts
TABLE_PROPERTY_REPORTS=PropertyReports
TABLE_REFERRALS=Referrals
TABLE_SITE_CONFIG=SiteConfig
TABLE_PARTNER_TASK_PROGRESS=PartnerTaskProgress

# Admin email addresses (comma-separated)
ADMIN_EMAILS=admin@yourdomain.com

# Vercel (auto-injected at build time)
# VERCEL_GIT_COMMIT_SHA=
